generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model MasterData {
  id                   Int               @id @default(autoincrement())
  category             String            @db.VarChar(32)
  name                 String            @db.VarChar(255)
  normalizedName       String            @map("normalized_name") @db.VarChar(255)
  metadata             Json              @default("{}") @db.JsonB
  isActive             Boolean           @default(true) @map("is_active")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  employeesByPosition  Employee[]        @relation("EmployeePosition")
  employeesBySpecialty Employee[]        @relation("EmployeeSpecialty")
  inventoryImports     InventoryImport[]
  supplierImports      InventoryImport[] @relation("InventoryImportSupplier")
  products             Product[]         @relation("ProductCategory")
  discountTargets      DiscountTarget[]

  @@unique([category, normalizedName], map: "uq_mdm_category_normalized")
  @@map("master_data")
}

model Employee {
  id                   Int         @id @default(autoincrement())
  fullName             String      @map("full_name") @db.VarChar(255)
  shortName            String      @map("short_name") @db.VarChar(64)
  dob                  DateTime?   @db.Date
  phone                String?     @db.VarChar(32)
  address              String?     @db.Text
  citizenId            String?     @unique(map: "employees_citizen_id_key") @map("citizen_id") @db.VarChar(32)
  citizenIdIssuedPlace String?     @map("citizen_id_issued_place") @db.VarChar(255)
  positionId           Int?        @map("position_id")
  specialtyId          Int?        @map("specialty_id")
  startDate            DateTime?   @map("start_date") @db.Date
  bankName             String?     @map("bank_name") @db.VarChar(255)
  bankAccountNo        String?     @map("bank_account_no") @db.VarChar(64)
  bankAccountName      String?     @map("bank_account_name") @db.VarChar(255)
  avatarUrl            String?     @map("avatar_url") @db.VarChar(2048)
  attachmentUrls       Json        @default("[]") @map("attachment_urls") @db.JsonB
  note                 String?     @db.Text
  isDeleted            Boolean     @default(false) @map("is_deleted")
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  position             MasterData? @relation("EmployeePosition", fields: [positionId], references: [id], onDelete: Restrict)
  specialty            MasterData? @relation("EmployeeSpecialty", fields: [specialtyId], references: [id], onDelete: Restrict)
  user                 User?

  @@map("employees")
}

model User {
  id            Int                    @id @default(autoincrement())
  employeeId    Int                    @unique(map: "users_employee_id_key") @map("employee_id")
  username      String                 @unique(map: "users_username_key") @db.VarChar(64)
  passwordHash  String                 @map("password_hash") @db.Text
  isSuperAdmin  Boolean                @default(false) @map("is_super_admin")
  roleLabel     String?                @map("role_label") @db.VarChar(64)
  permissions   Json                   @default("{}") @db.JsonB
  uiPreferences Json                   @default("{}") @map("ui_preferences") @db.JsonB
  isActive      Boolean                @default(true) @map("is_active")
  activeSessionId     String?          @map("active_session_id") @db.VarChar(64)
  activeSessionIp     String?          @map("active_session_ip") @db.VarChar(64)
  activeSessionDevice String?          @map("active_session_device") @db.VarChar(128)
  activeSessionAgent  String?          @map("active_session_agent") @db.VarChar(512)
  activeSessionAt     DateTime?        @map("active_session_at") @db.Timestamptz(6)
  lastRevokedNotice   Json?            @map("last_revoked_notice") @db.JsonB
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  employee      Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  orders        Order[]
  imports       InventoryImport[]
  settlements   CashDrawerSettlement[]
  schedules     WorkSchedule[]
  createdDiscounts Discount[]          @relation("DiscountCreator")
  pushSubscriptions PushSubscription[]
  posDraftsCreated PosDraft[]         @relation("PosDraftCreator")
  posDraftsUpdated PosDraft[]         @relation("PosDraftUpdater")

  @@map("users")
}

model DiningTable {
  id            Int     @id @default(autoincrement())
  name          String  @unique(map: "dining_tables_name_key") @db.VarChar(32)
  qrToken       String  @unique(map: "dining_tables_qr_token_key") @map("qr_token") @db.VarChar(64)
  status        String  @default("AVAILABLE") @db.VarChar(16)
  activeOrderId Int?    @map("active_order_id")
  activeOrder   Order?  @relation("ActiveOrder", fields: [activeOrderId], references: [id], onDelete: SetNull)
  orders        Order[] @relation("OrderTable")
  posDrafts     PosDraft[]

  @@map("dining_tables")
}

model Product {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(255)
  subtitle       String?         @db.VarChar(255)
  categoryId     Int?            @map("category_id")
  price          Decimal         @db.Decimal(12, 2)
  station        String          @db.VarChar(16)
  isAvailable    Boolean         @default(true) @map("is_available")
  imageUrl       String?         @map("image_url") @db.VarChar(2048)
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  category       MasterData?     @relation("ProductCategory", fields: [categoryId], references: [id], onDelete: SetNull)
  comboParents   ComboItem[]     @relation("ComboParent")
  comboChildren  ComboItem[]     @relation("ComboChild")
  modifierGroups ModifierGroup[]
  orderItems     OrderItem[]
  discountTargets DiscountTarget[]

  @@map("products")
}

model ComboItem {
  parentProductId Int     @map("parent_product_id")
  childProductId  Int     @map("child_product_id")
  quantity        Int     @default(1)
  parentProduct   Product @relation("ComboParent", fields: [parentProductId], references: [id], onDelete: Cascade)
  childProduct    Product @relation("ComboChild", fields: [childProductId], references: [id], onDelete: Restrict)

  @@id([parentProductId, childProductId])
  @@map("combo_items")
}

model ModifierGroup {
  id                Int        @id @default(autoincrement())
  productId         Int        @map("product_id")
  name              String     @db.VarChar(128)
  isRequired        Boolean    @default(false) @map("is_required")
  maxSelect         Int        @default(1) @map("max_select")
  isAutoSelect      Boolean    @default(false) @map("is_auto_select")
  allowSubstitution Boolean    @default(false) @map("allow_substitution")
  product           Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  modifiers         Modifier[]

  @@map("modifier_groups")
}

model Modifier {
  id                     Int           @id @default(autoincrement())
  groupId                Int           @map("group_id")
  name                   String        @db.VarChar(128)
  extraPrice             Decimal       @default(0) @map("extra_price") @db.Decimal(12, 2)
  isDefaultChecked       Boolean       @default(false) @map("is_default_checked")
  isAvailable            Boolean       @default(true) @map("is_available")
  defaultSubstituteName  String?       @map("default_substitute_name") @db.VarChar(128)
  allowedSubstituteNames Json?         @map("allowed_substitute_names")
  group                  ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@map("modifiers")
}

model PaymentAccount {
  id           Int      @id @default(autoincrement())
  label        String   @db.VarChar(64)
  bankCode     String   @map("bank_code") @db.VarChar(16)
  accountNo    String   @map("account_no") @db.VarChar(32)
  accountName  String   @map("account_name") @db.VarChar(128)
  priority     Int      @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  dailyLimit   Decimal? @map("daily_limit") @db.Decimal(12, 2)
  monthlyLimit Decimal? @map("monthly_limit") @db.Decimal(12, 2)
  yearlyLimit  Decimal? @map("yearly_limit") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders       Order[]

  @@unique([bankCode, accountNo], map: "uq_payment_accounts_bank_account")
  @@index([isActive, priority], map: "idx_payment_accounts_active_priority")
  @@map("payment_accounts")
}

model Order {
  id                 Int             @id @default(autoincrement())
  orderCode          String          @unique(map: "orders_order_code_key") @map("order_code") @db.VarChar(32)
  orderType          String          @map("order_type") @db.VarChar(16)
  orderSource        String          @map("order_source") @db.VarChar(16)
  tableId             Int?            @map("table_id")
  takeawayNumber      Int?            @map("takeaway_number")
  takeawayLabelFormat String?         @map("takeaway_label_format") @db.VarChar(16)
  status              String          @db.VarChar(16)
  paymentMethod      String?         @map("payment_method") @db.VarChar(16)
  paymentAccountId   Int?            @map("payment_account_id")
  cashAmount         Decimal         @default(0) @map("cash_amount") @db.Decimal(12, 2)
  transferAmount     Decimal         @default(0) @map("transfer_amount") @db.Decimal(12, 2)
  subtotalAmount     Decimal         @default(0) @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount     Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  discountId         Int?            @map("discount_id")
  discountSnapshot   Json?           @map("discount_snapshot") @db.JsonB
  totalAmount        Decimal         @default(0) @map("total_amount") @db.Decimal(12, 2)
  mergedIntoOrderId  Int?            @map("merged_into_order_id")
  tableTransferLogs  Json            @default("[]") @map("table_transfer_logs") @db.JsonB
  cashierId          Int?            @map("cashier_id")
  note               String?         @db.Text
  voidReason         String?         @map("void_reason") @db.Text
  pendingPaymentEdit Json?           @map("pending_payment_edit") @db.JsonB
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt             DateTime?       @map("paid_at") @db.Timestamptz(6)
  table              DiningTable?    @relation("OrderTable", fields: [tableId], references: [id], onDelete: Restrict)
  activeTables       DiningTable[]   @relation("ActiveOrder")
  mergedInto         Order?          @relation("OrderMerge", fields: [mergedIntoOrderId], references: [id], onDelete: Restrict)
  mergedOrders       Order[]         @relation("OrderMerge")
  cashier            User?           @relation(fields: [cashierId], references: [id], onDelete: SetNull)
  paymentAccount     PaymentAccount? @relation(fields: [paymentAccountId], references: [id], onDelete: Restrict)
  discount           Discount?       @relation(fields: [discountId], references: [id], onDelete: Restrict)
  items              OrderItem[]
  submittedPosDraft  PosDraft?

  @@index([createdAt(sort: Desc), status, paymentMethod], map: "idx_orders_created_status")
  @@index([status, orderSource, createdAt], map: "idx_orders_qr_pending")
  @@index([paymentAccountId, paidAt], map: "idx_orders_payment_account_paid")
  @@index([discountId], map: "idx_orders_discount_id")
  @@map("orders")
}

model PosDraft {
  id                  String      @id @default(cuid()) @db.VarChar(30)
  orderType           String?     @map("order_type") @db.VarChar(16)
  tableId             Int?        @map("table_id")
  items               Json        @default("[]") @db.JsonB
  note                String?     @db.Text
  revision            Int         @default(1)
  createdBy           Int         @map("created_by")
  updatedBy           Int         @map("updated_by")
  submittedOrderId    Int?        @unique(map: "uq_pos_drafts_submitted_order") @map("submitted_order_id")
  submitIdempotencyKey String?    @map("submit_idempotency_key") @db.VarChar(128)
  submittedAt         DateTime?   @map("submitted_at") @db.Timestamptz(6)
  createdAt           DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  table               DiningTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  creator             User        @relation("PosDraftCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  updater             User        @relation("PosDraftUpdater", fields: [updatedBy], references: [id], onDelete: Restrict)
  submittedOrder      Order?      @relation(fields: [submittedOrderId], references: [id], onDelete: Restrict)

  @@index([submittedAt, updatedAt(sort: Desc)], map: "idx_pos_drafts_active_updated")
  @@map("pos_drafts")
}

model TakeawaySequence {
  businessDate String   @id @map("business_date") @db.Char(8)
  lastNumber   Int      @default(0) @map("last_number")
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("takeaway_sequences")
}

model Discount {
  id                Int              @id @default(autoincrement())
  code              String           @unique @db.VarChar(32)
  name              String           @db.VarChar(128)
  valueType         String           @map("value_type") @db.VarChar(16)
  value             Decimal          @db.Decimal(12, 2)
  maxDiscountAmount Decimal?         @map("max_discount_amount") @db.Decimal(12, 2)
  scope             String           @db.VarChar(16)
  minOrderAmount    Decimal?         @map("min_order_amount") @db.Decimal(12, 2)
  startsAt          DateTime?        @map("starts_at") @db.Timestamptz(6)
  endsAt            DateTime?        @map("ends_at") @db.Timestamptz(6)
  activeWeekdays    Json             @default("[]") @map("active_weekdays") @db.JsonB
  timeWindowStart   String?          @map("time_window_start") @db.VarChar(5)
  timeWindowEnd     String?          @map("time_window_end") @db.VarChar(5)
  usageLimit        Int?             @map("usage_limit")
  usedCount         Int              @default(0) @map("used_count")
  isActive          Boolean          @default(true) @map("is_active")
  isArchived        Boolean          @default(false) @map("is_archived")
  createdBy         Int              @map("created_by")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  creator           User             @relation("DiscountCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  targets           DiscountTarget[]
  orders            Order[]

  @@index([isArchived, isActive, startsAt, endsAt], map: "idx_discounts_active_window")
  @@map("discounts")
}

model DiscountTarget {
  id         Int         @id @default(autoincrement())
  discountId Int         @map("discount_id")
  categoryId Int?        @map("category_id")
  productId  Int?        @map("product_id")
  discount   Discount    @relation(fields: [discountId], references: [id], onDelete: Cascade)
  category   MasterData? @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product?    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, categoryId], map: "uq_discount_target_category")
  @@unique([discountId, productId], map: "uq_discount_target_product")
  @@map("discount_targets")
}

model OrderItem {
  id                Int      @id @default(autoincrement())
  orderId           Int      @map("order_id")
  productId         Int      @map("product_id")
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal(12, 2)
  modifiersSnapshot Json     @default("[]") @map("modifiers_snapshot") @db.JsonB
  itemNote          String?  @map("item_note") @db.Text
  batchNo           Int      @default(1) @map("batch_no")
  itemSource        String   @default("POS_COUNTER") @map("item_source") @db.VarChar(16)
  kitchenStatus     String   @default("NEW") @map("kitchen_status") @db.VarChar(16)
  isTakeaway        Boolean  @default(false) @map("is_takeaway")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId, kitchenStatus], map: "idx_order_items_order_kitchen")
  @@index([kitchenStatus, itemSource, createdAt], map: "idx_order_items_qr_pending")
  @@map("order_items")
}

model InventoryImport {
  id                   Int         @id @default(autoincrement())
  ingredientMdmId      Int         @map("ingredient_mdm_id")
  supplierMdmId        Int?        @map("supplier_mdm_id")
  supplierNameSnapshot String?     @map("supplier_name_snapshot") @db.VarChar(255)
  itemNameSnapshot     String      @map("item_name_snapshot") @db.VarChar(255)
  unitName             String      @map("unit_name") @db.VarChar(64)
  unitPrice            Decimal     @map("unit_price") @db.Decimal(12, 2)
  quantity             Decimal     @db.Decimal(10, 2)
  totalCost            Decimal     @map("total_cost") @db.Decimal(12, 2)
  paymentSource        String      @default("CASH_DRAWER") @map("payment_source") @db.VarChar(16)
  importDate           DateTime    @default(dbgenerated("CURRENT_DATE")) @map("import_date") @db.Date
  note                 String?     @db.Text
  createdBy            Int         @map("created_by")
  isDeleted            Boolean     @default(false) @map("is_deleted")
  deletedAt            DateTime?   @map("deleted_at") @db.Timestamptz(6)
  createdAt            DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  ingredient           MasterData  @relation(fields: [ingredientMdmId], references: [id], onDelete: Restrict)
  supplier             MasterData? @relation("InventoryImportSupplier", fields: [supplierMdmId], references: [id], onDelete: Restrict)
  creator              User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@index([createdAt, paymentSource, isDeleted], map: "idx_imports_created_payment")
  @@map("inventory_imports")
}

model CashDrawerSettlement {
  id                   Int      @id @default(autoincrement())
  settlementDate       DateTime @map("settlement_date") @db.Date
  shiftName            String   @map("shift_name") @db.VarChar(64)
  openingBudget        Decimal  @map("opening_budget") @db.Decimal(12, 2)
  totalCashSales       Decimal  @map("total_cash_sales") @db.Decimal(12, 2)
  totalTransferSales   Decimal  @map("total_transfer_sales") @db.Decimal(12, 2)
  totalCashImports     Decimal  @map("total_cash_imports") @db.Decimal(12, 2)
  expectedCashInDrawer Decimal  @map("expected_cash_in_drawer") @db.Decimal(12, 2)
  actualCountedCash    Decimal  @map("actual_counted_cash") @db.Decimal(12, 2)
  discrepancyAmount    Decimal  @map("discrepancy_amount") @db.Decimal(12, 2)
  status               String   @db.VarChar(16)
  denominationsDetail  Json     @default("{}") @map("denominations_detail") @db.JsonB
  note                 String?  @db.Text
  closedBy             Int      @map("closed_by")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  closer               User     @relation(fields: [closedBy], references: [id], onDelete: Restrict)

  @@unique([settlementDate, shiftName], map: "uq_settlement_date_shift")
  @@index([settlementDate(sort: Desc)], map: "idx_settlements_date")
  @@map("cash_drawer_settlements")
}

model WorkSchedule {
  id            Int      @id @default(autoincrement())
  weekStartDate DateTime @map("week_start_date") @db.Date
  dayOfWeek     Int      @map("day_of_week")
  timeSlot      String   @map("time_slot") @db.VarChar(128)
  employeeIds   Json     @default("[]") @map("employee_ids") @db.JsonB
  createdBy     Int      @map("created_by")
  updatedAt     DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  creator       User     @relation(fields: [createdBy], references: [id], onDelete: Restrict)

  @@unique([weekStartDate, dayOfWeek, timeSlot], map: "uq_schedule_cell")
  @@map("work_schedules")
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  module        String   @db.VarChar(32)
  action        String   @db.VarChar(32)
  actorId       Int?     @map("actor_id")
  actorFullName String   @map("actor_full_name") @db.VarChar(128)
  actorUsername String   @map("actor_username") @db.VarChar(64)
  summary       String   @db.Text
  ipAddress     String?  @map("ip_address") @db.VarChar(64)
  deviceLabel   String?  @map("device_label") @db.VarChar(128)
  metadata      Json     @default("{}") @db.JsonB
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([module, createdAt(sort: Desc)], map: "idx_audit_logs_module_created")
  @@index([ipAddress], map: "idx_audit_logs_ip")
  @@map("audit_logs")
}

model PushSubscription {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  sessionId      String?   @map("session_id") @db.VarChar(64)
  endpoint       String    @unique(map: "uq_push_subscriptions_endpoint") @db.VarChar(2048)
  p256dh         String    @db.VarChar(512)
  auth           String    @db.VarChar(256)
  userAgent      String?   @map("user_agent") @db.VarChar(512)
  deviceLabel    String?   @map("device_label") @db.VarChar(128)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  lastNotifiedAt DateTime? @map("last_notified_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId], map: "idx_push_subscriptions_user_session")
  @@map("push_subscriptions")
}
