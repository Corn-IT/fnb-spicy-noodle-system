{
  "name": "@fnb/api-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:setup": "prisma generate && prisma migrate deploy && prisma db seed"
  },
  "dependencies": {
    "@fnb/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/websockets": "11.2.8",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "^4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.6",
    "@types/node": "26.1.0",
    "prisma": "6.19.3",
    "tsx": "4.21.0"
  }
}
