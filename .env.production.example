# ==============================================================================
# TEMPLATE BIẾN MÔI TRƯỜNG PRODUCTION CHO VPS (DOCKER COMPOSE + CADDY)
# Copy file này thành `.env` (cho biến compose ${DOMAIN}, ${POSTGRES_PASSWORD})
# VÀ `.env.production` (cho container api-server), sau đó điền giá trị thật!
# ==============================================================================

# 1. Domain chính trỏ về VPS (VD: pos.micayseoul.vn) - Bắt buộc HTTPS qua Cloudflare Proxy Full (Strict)
DOMAIN=pos.yourdomain.vn

# 2. PostgreSQL (bên trong mạng Docker fnb_internal, KHÔNG mở cổng 5432 ra ngoài)
POSTGRES_PASSWORD=replace-with-strong-postgres-password-at-least-24-chars
FNB_DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password-at-least-24-chars@postgres:5432/fnb_pos?schema=public
DATABASE_URL=postgresql://postgres:replace-with-strong-postgres-password-at-least-24-chars@postgres:5432/fnb_pos?schema=public

# 3. Bảo mật JWT (tối thiểu 64 ký tự ngẫu nhiên, sinh bằng: openssl rand -hex 48)
FNB_JWT_SECRET=replace-with-random-secret-at-least-64-characters-long-for-production-2026
JWT_SECRET=replace-with-random-secret-at-least-64-characters-long-for-production-2026
FNB_JWT_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
FNB_JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d

# 4. API & CORS (khớp chính xác URL https:// của DOMAIN ở mục 1)
FNB_PORT=3000
PORT=3000
FNB_CORS_ORIGIN=https://pos.yourdomain.vn
CORS_ORIGIN=https://pos.yourdomain.vn
NODE_ENV=production
