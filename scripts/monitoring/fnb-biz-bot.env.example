# Example config for Bot #2 (@POS_Lona_bot) on VPS -> copy to /etc/fnb-biz-bot.env (chmod 600)
FNB_ALERT_PROJECT_NAME="Ăn Vặt Tran"
FNB_DOMAIN=pos.anvattran.com
FNB_PROJECT_DIR=/opt/fnb-pos
FNB_BIZ_BOT_TOKEN=
FNB_BIZ_CHAT_ID=
FNB_GEMINI_API_KEY=
FNB_GEMINI_MODEL=gemini-3.5-flash-lite
FNB_GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
FNB_GEMINI_MODEL_POOL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash,gemini-4-hydrogen
FNB_BOT_RO_DB_USER=fnb_bot_ro
FNB_BIZ_HIGH_VOID_THRESHOLD=150000
FNB_BIZ_ALERT_STATE_FILE=/var/lib/fnb-biz-alerts/state.json
# Optional JSON mapping of employee name -> Telegram username for /lich & HR lookups:
# FNB_BIZ_STAFF_TELEGRAM_MAP={"Huy":"@huy_pos","Lan":"@lan_pos"}
# Gemini API Quota settings matching Google AI Studio (default: Free Tier gemini-3.5-flash-lite)
FNB_GEMINI_TIER_NAME=Free Tier
FNB_GEMINI_RPD_LIMIT=500
FNB_GEMINI_RPM_LIMIT=15
FNB_GEMINI_TPM_LIMIT=250000
# Optional daily token budget alert/estimate (blank = show RPD calls + estimated AI questions):
# FNB_GEMINI_DAILY_TOKEN_BUDGET=
