%% ============================================================================
%% FILE: docs/architecture/03-verified-sequences.mmd
%% PROJECT: Hệ thống POS & Quản trị Vận hành Quán Mì Cay (fnb-spicy-noodle-system)
%% PHASE: Phase 2 Baseline + Post-Implementation Sync
%% AUTHOR: Principal System Architect & QA Auditor
%% LAST UPDATED: 2026-11-28 (Synced with NestJS controllers, services & PosSocketGateway)
%% ============================================================================
%% BAO PHỦ 4 LUỒNG TUẦN TỰ CỐT LÕI ĐÃ KIỂM ĐỊNH CHÉO:
%% - LUỒNG 1 (SEQ-01): Khách quét QR đặt món (/q/:token hoặc /qr/:token, hỗ trợ QR Security
%%   Wi-Fi/GPS & QR Mang về), Web Push + Voice Alert, Auto-Cancel nếu quá hạn, và Gọi thêm
%%   món kèm tự động redirect phiên activeOrderId khi đã đổi/gộp bàn (EC-POS-01).
%% - LUỒNG 2 (SEQ-02): Tách đơn bếp (Delta Split + Combo Explosion + In 80mm đa nền tảng:
%%   Browser / RawBT USB / LAN :9100), Áp mã giảm giá (Story 18), In tạm tính kèm xoay vòng
%%   PaymentAccount VietQR theo hạn mức (Story 13, giữ SERVING - Invariant 4), và Chốt thanh toán.
%% - LUỒNG 3 (SEQ-03): Thao tác bàn (MOVE / MERGE / SWAP / TO_TAKEAWAY) gồm chuyển đổi 2 chiều
%%   TAKEAWAY <-> DINE_IN với prisma.$transaction & khoá dòng FOR UPDATE (Invariant 5).
%% - LUỒNG 4 (SEQ-04): Nhập hàng tự chuẩn hoá MDM (INGREDIENT & SUPPLIER - Invariant 7),
%%   Kết ca đối soát dòng tiền (Blind Mode, Bù chênh lệch, CASH/SPLIT - CASH_DRAWER) và AuditLog.
%% ============================================================================

sequenceDiagram
    autonumber
    actor Guest as Khách hàng (Mobile QR)
    participant MobileUI as Web App QR (/q/:token, /qr/:token)
    participant PosUI as Màn hình POS (/pos, /pos/touch)
    participant API as NestJS API & Guards
    participant WS as PosSocketGateway (/pos)
    participant DB as PostgreSQL 16 ($transaction)
    participant Printer as Máy in 80mm (Browser / RawBT / LAN :9100)

    %% ========================================================================
    %% LUỒNG 1: KHÁCH QUÉT QR ĐẶT MÓN, BẢO MẬT QR, REALTIME & REDIRECT PHIÊN
    %% ========================================================================
    rect rgb(235, 248, 255)
        Note over Guest,DB: LUỒNG 1 (SEQ-01): KHÁCH QUÉT QR ĐẶT MÓN, WEB PUSH / VOICE ALERT & REDIRECT KHI ĐỔI BÀN

        Guest->>MobileUI: Quét mã QR tại Bàn 01 (/q/:qrToken hoặc /qr/:qrToken)
        MobileUI->>API: GET /api/v1/public/menu?token=qrToken&lat=...&lng=...
        API->>API: QrSecurityService kiểm tra Wi-Fi IP / GPS Geofence (nếu bật)
        API->>DB: SELECT dining_tables, products (3 tầng + modifier_groups/modifiers), store_settings
        DB-->>API: Thông tin Bàn 01 (hoặc QR Mang về) + Menu + Tuỳ chọn (Cay, Size M/L, Auto-check, Đổi món)
        API-->>MobileUI: 200 OK { tableId, tableName, activeOrderId, menu, qrSecurity }

        Guest->>MobileUI: Chọn 2 Mì Kim Chi Bò (Cấp 3, +Bò viên) + 1 Combo Đôi -> Bấm "Gửi đơn"
        MobileUI->>API: POST /api/v1/public/orders/qr { qrToken, activeOrderId: null, items, lat, lng }
        API->>DB: BEGIN $transaction (SELECT dining_tables WHERE id=1 FOR UPDATE)
        API->>DB: INSERT orders (order_type='DINE_IN', order_source='QR_CODE', table_id=1, status='PENDING') -> id=538
        API->>DB: INSERT order_items (order_id=538, batch_no=1, item_source='QR_CODE', kitchen_status='NEW')
        API->>DB: UPDATE dining_tables SET status='PENDING', active_order_id=538 WHERE id=1
        DB-->>API: COMMIT (orderId=538, orderCode="HD-20261126-0039")
        API->>WS: Emit 'order:qr_new' & 'table:grid_sync' -> 'pos_cashier_room' + gửi Web Push (push_subscriptions)
        WS-->>PosUI: Chuông + Giọng nói tiếng Việt + Bàn 01 nhấp nháy chờ duyệt (Service Worker kiểm tra qr-pending-check)
        API-->>MobileUI: 201 Created { orderId: 538, status: "PENDING", tableLabel: "Bàn 01" }
        MobileUI->>MobileUI: Lưu activeOrderId=538 & Join WS rooms 'table_session_1' + 'order_session_538'

        Note over Guest,DB: Nếu quá hạn chưa duyệt, QrAutoCancelService tự huỷ đơn PENDING & phát 'order:qr_auto_cancelled'.<br/>Nếu đã duyệt & chuyển sang Bàn 07 (hoặc Gộp vào đơn 540 ở Bàn 07), khách gọi thêm trên tab cũ (EC-POS-01):
        Guest->>MobileUI: Chọn thêm 2 Trà đào (Size L) -> Bấm "Gọi thêm món"
        MobileUI->>API: POST /api/v1/public/orders/qr { qrToken, activeOrderId: 538, items }
        API->>DB: BEGIN $transaction (SELECT * FROM orders WHERE id=538 FOR UPDATE)
        alt Đơn 538 đã MOVE sang Bàn 07 (status='SERVING', table_id=7)
            API->>DB: Nối order_items mới vào order_id=538 (item_source='QR_CODE', kitchen_status='NEW', batch_no=2)
            API->>DB: Tính lại subtotal_amount, discount_amount, total_amount cho đơn 538
        else Đơn 538 đã MERGE vào đơn 540 tại Bàn 07 (status='MERGED', merged_into_order_id=540)
            API->>DB: SELECT * FROM orders WHERE id=540 FOR UPDATE
            API->>DB: Nối order_items mới vào order_id=540 (item_source='QR_CODE', kitchen_status='NEW', batch_no=MAX+1)
            API->>DB: Tính lại subtotal_amount, discount_amount, total_amount cho đơn 540
        end
        DB-->>API: COMMIT trên hoá đơn của Bàn 07 (Bàn 01 KHÔNG bị tạo đơn mới!)
        API->>WS: Emit 'order:qr_addon' & 'table:grid_sync' -> 'pos_cashier_room' + Web Push
        WS-->>PosUI: Bàn 07 hiện badge "Gọi thêm Lượt 2" & cập nhật Live Invoice
        API-->>MobileUI: 200 OK { activeOrderId: 538/540, currentTableLabel: "Bàn 07", batchNo: 2 }
    end

    %% ========================================================================
    %% LUỒNG 2: TÁCH BẾP, GIẢM GIÁ, TẠM TÍNH XOAY VÒNG VIETQR & THANH TOÁN
    %% ========================================================================
    rect rgb(255, 248, 235)
        Note over PosUI,Printer: LUỒNG 2 (SEQ-02): DELTA SPLIT, GIẢM GIÁ, TẠM TÍNH XOAY VÒNG QR (GIỮ SERVING) & CHỐT THANH TOÁN

        PosUI->>API: Thu ngân bấm [Tách đơn]: POST /api/v1/pos/orders/538/split-kitchen
        API->>DB: BEGIN $transaction (SELECT * FROM orders WHERE id=538 FOR UPDATE)
        API->>DB: SELECT * FROM order_items JOIN products WHERE order_id=538 AND kitchen_status='NEW'
        alt Không có món kitchen_status='NEW'
            DB-->>API: COMMIT (Empty set)
            API-->>PosUI: 200 OK { tickets: [], message: "Không có món mới cần tách" } (Idempotent)
        else Có món mới cần tách bếp
            API->>DB: Phân rã COMBO qua combo_items về trạm vật lý (BEP_NAU, BEP_CHIEN, PHA_CHE, BEP_*)
            API->>DB: Nếu order.status='PENDING' -> nâng lên 'SERVING' & dining_tables.status='OCCUPIED'
            API->>DB: UPDATE order_items SET kitchen_status='PRINTED', batch_no=currentBatch WHERE kitchen_status='NEW'
            API->>DB: INSERT audit_logs (module='POS', action='Tách phiếu bếp')
            DB-->>API: COMMIT
            API->>WS: Emit 'order:status_updated' + 'qr:order_notice' -> 'order_session_538'
            API-->>PosUI: 200 OK { batchNo, isAddonBatch, tickets }
            PosUI->>Printer: In 80mm theo printTemplates (Browser --kiosk-printing / RawBT USB / POST /pos/print/lan-escpos)
        end

        opt Thu ngân áp mã giảm giá (Story 18) hoặc Giảm tay (pos:manualDiscount)
            PosUI->>API: POST /api/v1/pos/orders/538/discount { kind: 'CODE' | 'MANUAL', ... }
            API->>DB: Validate điều kiện mã (scope, min_order, window, usage_limit) -> cập nhật subtotal/discount/total
            API-->>PosUI: 200 OK { subtotalAmount, discountAmount, totalAmount, discountSnapshot }
        end

        Note over PosUI,Printer: BƯỚC 1: IN TẠM TÍNH KÈM XOAY VÒNG MÃ VIETQR (INVARIANT 4 - GIỮ NGUYÊN SERVING)
        PosUI->>API: POST /api/v1/pos/orders/538/provisional-bill (hoặc /split-provisional-bill)
        API->>DB: Duyệt payment_accounts (is_active=TRUE, priority ASC) tính doanh thu PAID theo ngày/tháng/năm (+07:00)
        API->>DB: Chọn mã QR đầu tiên chưa vượt hạn mức (hoặc fallback priority #1 kèm qrOverLimit=true) -> lưu payment_account_id
        API->>API: Sinh URL VietQR Napas247 (amount=total_amount, addInfo="TT B07 HD-20261126-0039")
        API-->>PosUI: 200 OK { order, status: "SERVING", vietQrUrl, paymentAccount, qrRotated, qrOverLimit }
        PosUI->>Printer: In "PHIẾU TẠM TÍNH" (đơn VẪN giữ status='SERVING', bàn giữ 'OCCUPIED')

        Note over PosUI,Printer: BƯỚC 2: CHỐT THANH TOÁN ĐÓNG ĐƠN (INVARIANT 4 - CHUYỂN SANG PAID)
        PosUI->>API: POST /api/v1/pos/orders/538/checkout { paymentMethod: "CASH"|"TRANSFER"|"SPLIT", cashAmount, transferAmount }
        API->>DB: BEGIN $transaction (Khoá orders FOR UPDATE -> dining_tables FOR UPDATE)
        API->>DB: Kiểm tra chk_order_payment_amounts, tăng discounts.used_count (nếu có mã), gán payment_account_id (nếu TRANSFER/SPLIT)
        API->>DB: UPDATE orders SET status='PAID', paid_at=NOW(); UPDATE dining_tables SET status='AVAILABLE', active_order_id=NULL
        API->>DB: INSERT audit_logs (module='POS', action='Thanh toán đơn')
        DB-->>API: COMMIT
        API->>WS: Emit 'order:status_updated' { status: 'PAID' } -> 'order_session_538' & 'table:grid_sync' -> 'pos_cashier_room'
        API-->>PosUI: 200 OK { status: "PAID", paidAt }
        opt Thanh toán tiền mặt & bật mở két tự động (pos:openCashDrawer)
            PosUI->>Printer: Gửi lệnh ESC/POS bung két tiền RJ11 (RawBT / LAN :9100)
        end
    end

    %% ========================================================================
    %% LUỒNG 3: THAO TÁC BÀN (MOVE / MERGE / SWAP / TO_TAKEAWAY) CÓ KHOÁ DÒNG
    %% ========================================================================
    rect rgb(240, 255, 240)
        Note over Guest,Printer: LUỒNG 3 (SEQ-03): MOVE / MERGE / SWAP / TO_TAKEAWAY VỚI FOR UPDATE (INVARIANT 5 & EC-POS-03)

        PosUI->>API: POST /api/v1/pos/orders/538/table-action { action: "MOVE"|"MERGE"|"SWAP"|"TO_TAKEAWAY", targetTableId?, reason }
        API->>DB: BEGIN $transaction
        API->>DB: 1. Khoá orders theo ORDER BY id ASC FOR UPDATE
        API->>DB: 2. Khoá dining_tables theo ORDER BY id ASC FOR UPDATE
        alt order_type == 'TAKEAWAY' và action == 'SWAP'
            DB-->>API: ROLLBACK
            API-->>PosUI: 409 Conflict { code: "POS_TAKEAWAY_CANNOT_MERGE" }
        else action == 'TO_TAKEAWAY' (Tại bàn -> Mang về)
            API->>DB: Cấp takeaway_number = MAX(today) + 1; table_id = NULL; order_type = 'TAKEAWAY'; bàn nguồn -> AVAILABLE
        else action == 'MOVE' (Bàn -> Bàn trống, hoặc Mang về -> Bàn trống)
            API->>DB: Kiểm tra targetTable AVAILABLE -> cập nhật table_id (nếu từ TAKEAWAY: set order_type='DINE_IN', is_takeaway=false)
        else action == 'MERGE' (Bàn/Mang về -> Bàn đang OCCUPIED)
            API->>DB: Chuyển toàn bộ order_items sang đơn đích (GIỮ NGUYÊN kitchen_status), tính lại tiền, đơn nguồn -> MERGED
        else action == 'SWAP' (Hoán đổi 2 bàn đang mở)
            API->>DB: Hoán đổi chéo table_id & dining_tables.active_order_id
        end
        API->>DB: Ghi table_transfer_logs & audit_logs; kiểm tra EXISTS item PRINTED -> requireKitchenNoticePrint
        DB-->>API: COMMIT
        API->>WS: Emit 'order:session_redirected' & 'qr:order_notice' -> điện thoại khách + 'table:grid_sync' -> POS
        API-->>PosUI: 200 OK { requireKitchenNoticePrint, kitchenTransferSlip }
        opt requireKitchenNoticePrint == true (EC-POS-04)
            PosUI->>Printer: In "PHIẾU THÔNG BÁO ĐỔI BÀN" cho các trạm bếp bị ảnh hưởng
        end
    end

    %% ========================================================================
    %% LUỒNG 4: NHẬP HÀNG CHUẨN HOÁ MDM & KẾT CA ĐỐI SOÁT DÒNG TIỀN
    %% ========================================================================
    rect rgb(250, 240, 255)
        Note over PosUI,DB: LUỒNG 4 (SEQ-04): NHẬP HÀNG CHUẨN HOÁ MDM (INVARIANT 7) & KẾT CA BLIND MODE (INVARIANT 6 & 8)

        PosUI->>API: GET /api/v1/mdm/lookup?category=INGREDIENT|SUPPLIER|UNIT (AuthenticatedOnly - Invariant 8)
        API-->>PosUI: 200 OK (Danh sách chuẩn hoá + { default_unit, last_price })

        PosUI->>API: POST /api/v1/inventory-imports (RequirePermission('inventory', 'create'))
        API->>DB: BEGIN $transaction
        loop Cho từng dòng hàng
            API->>API: MdmService.findOrCreate('INGREDIENT' & 'SUPPLIER'): trim -> Title Case -> normalizeVietnameseString
            API->>DB: Upsert master_data & INSERT inventory_imports (payment_source='CASH_DRAWER'|'EXTERNAL')
        end
        API->>DB: INSERT audit_logs (module='INVENTORY')
        DB-->>API: COMMIT
        API-->>PosUI: 201 Created

        Note over PosUI,DB: CUỐI CA: XEM PREVIEW (BLIND MODE VỚI THU NGÂN) & CHỐT KẾT CA (MODULE 4)
        PosUI->>API: GET /api/v1/cashflow/preview (Thu ngân: blindMode=true ẩn tiền lý thuyết; SuperAdmin: hiện đầy đủ)
        API-->>PosUI: 200 OK { openingBudget, blindMode, expectedCashInDrawer? }
        PosUI->>API: POST /api/v1/cashflow/settle { settlementDate, shiftName, actualCountedCash, denominationsDetail, note }
        API->>API: JwtAuthGuard (401) -> RbacGuard ('cashflow:create' -> 403)
        API->>DB: BEGIN $transaction
        API->>DB: 1. total_cash_sales = SUM(CASE CASH->total_amount, SPLIT->cash_amount) WHERE status='PAID'
        API->>DB: 2. total_transfer_sales = SUM(CASE TRANSFER->total_amount, SPLIT->transfer_amount) (KHÔNG cộng két!)
        API->>DB: 3. total_cash_imports = SUM(total_cost) WHERE payment_source='CASH_DRAWER' AND is_deleted=FALSE
        API->>API: 4. expected_cash = opening_budget + total_cash_sales - total_cash_imports; discrepancy = actual - expected
        API->>DB: INSERT cash_drawer_settlements + audit_logs (module='CASHFLOW')
        DB-->>API: COMMIT
        API-->>PosUI: 201 Created { expectedCashInDrawer, actualCountedCash, discrepancyAmount, status, cashRetainedInDrawer, cashToHandOver }
    end
