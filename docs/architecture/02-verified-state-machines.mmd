%% ĐỐI CHIẾU CHÉO CÁC QUY TẮC BẤT BIẾN (HARD INVARIANTS):
%% 1. Điểm khởi tạo Order:
%%    - Khách quét QR (Tại bàn DINE_IN hoặc Mang về QR TAKEAWAY) -> PENDING (chờ thu ngân duyệt).
%%    - Thu ngân tạo đơn tại quầy (POS_COUNTER: DINE_IN hoặc TAKEAWAY MV-#) -> SERVING.
%% 2. Hard Invariant 3 (Delta Split):
%%    - API split-kitchen CHỈ chuyển OrderItem từ NEW -> PRINTED (kèm nâng PENDING -> SERVING).
%%    - CẤM chuyển ngược PRINTED -> NEW trong mọi trường hợp (kể cả MOVE/MERGE/SWAP/TO_TAKEAWAY).
%% 3. Hard Invariant 4 (Tạm tính vs Thanh toán):
%%    - "In tạm tính (Kèm VietQR động xoay vòng)" & "Tạm tính tách bill" giữ nguyên SERVING.
%%    - Chỉ "Thanh toán -> Xác nhận (2 bước)" mới chuyển SERVING -> PAID.
%% 4. Hard Invariant 5 (Concurrency & Table Actions — EC-POS-03 cập nhật):
%%    - Hỗ trợ 4 hành động: MOVE, MERGE, SWAP, TO_TAKEAWAY trong $transaction FOR UPDATE.
%%    - Hỗ trợ chuyển đổi 2 chiều TAKEAWAY <-> DINE_IN (MOVE/MERGE từ TAKEAWAY vào bàn,
%%      hoặc TO_TAKEAWAY từ bàn ra Mang về). CHỈ CẤM SWAP đối với đơn TAKEAWAY (409).
%% ============================================================================

stateDiagram-v2
    direction TB

    %% ========================================================================
    %% 1. VÒNG ĐỜI HOÁ ĐƠN (ORDER LIFECYCLE STATE MACHINE)
    %% ========================================================================
    state "1. Vòng đời Đơn hàng (orders.status)" as OrderLifecycle {
        [*] --> ORD_PENDING : Khách quét QR đặt món (/q/:token hoặc /qr/:token)\n(DINE_IN tại bàn hoặc TAKEAWAY QR, order_source=QR_CODE)
        [*] --> ORD_SERVING : Thu ngân tạo đơn tại quầy POS (/pos hoặc /pos/touch)\n(DINE_IN chọn bàn hoặc TAKEAWAY MV-#)

        state "PENDING (Chờ thu ngân duyệt)" as ORD_PENDING
        state "SERVING (Đang phục vụ tại bàn / Mang về)" as ORD_SERVING {
            [*] --> ActiveSession
            ActiveSession --> ActiveSession : 1. Gọi thêm món (QR Add-on / POS Patch Items)\n-> Thêm order_items (kitchen_status=NEW, item_source, is_takeaway)
            ActiveSession --> ActiveSession : 2. Bấm [Tách đơn] (split-kitchen) / [In lại bếp] (reprint-kitchen)\n-> Lọc items NEW -> PRINTED, gán batch_no\n-> GIỮ NGUYÊN status=SERVING (Invariant 3)
            ActiveSession --> ActiveSession : 3. Áp/Gỡ Mã giảm giá hoặc Giảm tay (pos:manualDiscount)\n-> Tính lại subtotal_amount - discount_amount = total_amount
            ActiveSession --> ActiveSession : 4. Bấm [In tạm tính] / [Tạm tính tách đơn] (provisional-bill)\n-> Xoay vòng payment_accounts theo hạn mức + VietQR Napas247\n-> GIỮ NGUYÊN status=SERVING (Invariant 4)
            ActiveSession --> ActiveSession : 5. MOVE / SWAP / TO_TAKEAWAY (table-action)\n-> Khoá dòng FOR UPDATE (orders -> dining_tables)\n-> Đổi table_id hoặc chuyển sang TAKEAWAY, emit session_redirected
            ActiveSession --> ActiveSession : 6. Tách thanh toán một phần (split-checkout)\n-> Tạo hoá đơn con PAID cho các món tách; đơn gốc giữ SERVING
        }
        state "MERGED (Đã gộp vào bàn đích)" as ORD_MERGED
        state "PAID (Đã thu tiền & Đóng đơn)" as ORD_PAID {
            [*] --> PaidSettled
            PaidSettled --> PaymentEditPending : Nhân viên gửi yêu cầu sửa PTTT\n(PATCH /invoices/:id/payment-method)
            PaymentEditPending --> PaidSettled : Quản lý duyệt / từ chối (invoices:approve)\n(POST /invoices/:id/payment-method/review)
        }
        state "VOIDED (Đã huỷ - Loại khỏi doanh thu)" as ORD_VOIDED

        ORD_PENDING --> ORD_SERVING : Thu ngân bấm [Duyệt đơn] (approve) hoặc [Tách đơn] (split-kitchen)\n(Bàn chuyển từ PENDING -> OCCUPIED)
        ORD_PENDING --> ORD_VOIDED : 1. Thu ngân từ chối / huỷ đơn QR ảo\n2. Hệ thống tự động huỷ quá hạn (QrAutoCancelService -> order:qr_auto_cancelled)\n(Giải phóng bàn về AVAILABLE)

        ORD_SERVING --> ORD_MERGED : Gộp bàn (MERGE vào bàn đích đang OCCUPIED)\n-> Hỗ trợ cả DINE_IN -> DINE_IN và TAKEAWAY -> DINE_IN (gán is_takeaway=true)\n-> Chuyển toàn bộ order_items sang đơn đích, ghi merged_into_order_id

        ORD_SERVING --> ORD_PAID : Thu ngân bấm [Thanh toán] -> Xác nhận 2 bước (checkout)\n-> Chọn CASH / TRANSFER / SPLIT (ràng buộc chk_order_payment_amounts)\n-> Ghi paid_at=NOW(), gắn payment_account_id nếu TRANSFER/SPLIT\n-> Giải phóng bàn về AVAILABLE, emit order:status_updated (Invariant 4)

        ORD_SERVING --> ORD_VOIDED : Huỷ đơn đang mở (POST /pos/orders/:id/cancel)\n(Bắt buộc nhập void_reason, giải phóng bàn về AVAILABLE)

        ORD_PAID --> ORD_VOIDED : Huỷ hoá đơn ngoại lệ sau thanh toán (POST /invoices/:id/void)\n-> Bắt buộc quyền invoices:void + void_reason >= 10 ký tự\n-> Tự động loại trừ khỏi Kết ca (Module 4) & Doanh thu QR (EC-FIN-01)

        ORD_MERGED --> [*]
        ORD_PAID --> [*]
        ORD_VOIDED --> [*]
    }

    %% ========================================================================
    %% 2. VÒNG ĐỜI MÓN ĂN TRONG BẾP (ORDER_ITEM KITCHEN STATE MACHINE)
    %% ========================================================================
    state "2. Vòng đời Món ăn & Tách bếp (order_items.kitchen_status)" as OrderItemLifecycle {
        [*] --> ITEM_NEW : Thêm món vào đơn (item_source=POS_COUNTER | QR_CODE)\n(Lưu modifiers_snapshot JSONB, unit_price, is_takeaway)

        state "NEW (Mới gọi - Chưa in bếp)" as ITEM_NEW
        state "PRINTED (Đã tách & In phiếu xuống trạm bếp)" as ITEM_PRINTED
        state "CANCELLED (Đã huỷ sau khi in bếp)" as ITEM_CANCELLED
        state "DELETED (Xoá cứng khỏi DB)" as ITEM_DELETED

        ITEM_NEW --> ITEM_NEW : Sửa số lượng / Tuỳ chọn / Ghi chú / Đổi bàn / Đánh dấu mang về\n(Cập nhật trực tiếp trong DB, KHÔNG cần in phiếu báo bếp)

        ITEM_NEW --> ITEM_DELETED : 1. Thu ngân xoá dòng món khi chưa tách bếp (EC-POS-06 Nhánh A)\n2. QrAutoCancelService tự huỷ món QR add-on quá hạn chưa duyệt

        ITEM_NEW --> ITEM_PRINTED : Thu ngân bấm [Tách đơn] (POST /pos/orders/:id/split-kitchen)\n-> Nếu station=COMBO: Phân rã thành sub-items (BEP_NAU/BEP_CHIEN/PHA_CHE/BEP_*)\n-> Gán batch_no = MAX(batch_no) + 1\n-> In nhiệt 80mm cắt rời theo trạm (Browser / RawBT USB / LAN :9100)

        ITEM_PRINTED --> ITEM_PRINTED : 1. Đơn thực hiện MOVE / MERGE / SWAP / TO_TAKEAWAY\n-> GIỮ NGUYÊN kitchen_status=PRINTED (Chống in nấu lại!)\n-> requireKitchenNoticePrint=true -> In PHIẾU THÔNG BÁO ĐỔI BÀN (EC-POS-04)\n2. In lại phiếu bếp theo yêu cầu (reprint-kitchen)\n3. Sửa ghi chú/tuỳ chọn sau khi in -> In phiếu báo điều chỉnh bếp

        ITEM_PRINTED --> ITEM_CANCELLED : Thu ngân bấm [Huỷ món bếp] (EC-POS-06 Nhánh B)\nhoặc đơn bị VOIDED\n-> Tính lại subtotal/discount/total đơn hàng\n-> In PHIẾU BÁO HUỶ MÓN xuống trạm bếp tương ứng

        ITEM_DELETED --> [*]
        ITEM_CANCELLED --> [*]
    }

    %% ========================================================================
    %% 3. VÒNG ĐỜI TRẠNG THÁI BÀN ĂN VẬT LÝ (DINING_TABLES STATE MACHINE)
    %% ========================================================================
    state "3. Vòng đời Bàn ăn Vật lý (dining_tables.status)" as DiningTableLifecycle {
        [*] --> TBL_AVAILABLE : Khởi tạo bàn vật lý (Bàn 01 .. Bàn N)\n(active_order_id = NULL)

        state "AVAILABLE (Bàn trống)" as TBL_AVAILABLE
        state "PENDING (Có đơn QR mới chờ duyệt)" as TBL_PENDING
        state "OCCUPIED (Đang phục vụ)" as TBL_OCCUPIED

        TBL_AVAILABLE --> TBL_PENDING : Khách quét QR tại bàn gửi đơn lần đầu\n-> Gán active_order_id = newOrder.id\n-> Emit order:qr_new + Voice/WebPush + Nhấp nháy chờ duyệt

        TBL_AVAILABLE --> TBL_OCCUPIED : 1. Thu ngân tạo đơn DINE_IN tại quầy POS\n2. Nhận đơn MOVE từ bàn khác hoặc từ đơn TAKEAWAY

        TBL_PENDING --> TBL_OCCUPIED : Thu ngân bấm [Duyệt đơn] hoặc [Tách đơn]

        TBL_PENDING --> TBL_AVAILABLE : Thu ngân từ chối/huỷ đơn QR hoặc QrAutoCancelService tự huỷ\n-> Reset active_order_id = NULL

        TBL_OCCUPIED --> TBL_OCCUPIED : 1. Khách gọi thêm món (QR Add-on) / Tách bếp / Tạm tính / Tách thanh toán\n2. Hoán đổi 2 bàn đang ăn (SWAP: đổi chéo active_order_id)\n3. Nhận gộp bàn (MERGE từ DINE_IN hoặc TAKEAWAY)

        TBL_OCCUPIED --> TBL_AVAILABLE : 1. Chốt Thanh toán thành công (Order -> PAID)\n2. Chuyển bàn sang bàn trống (MOVE source) hoặc sang Mang về (TO_TAKEAWAY)\n3. Gộp toàn bộ đơn sang bàn khác (MERGE source)\n4. Huỷ toàn bộ đơn đang mở (Order -> VOIDED)\n-> Reset active_order_id = NULL
    }

%% ============================================================================
%% DANH SÁCH CHUYỂN ĐỔI TRẠNG THÁI BỊ CẤM TUYỆT ĐỐI (FORBIDDEN TRANSITIONS)
%% ============================================================================
%% [Order Status]:
%%   - FORBIDDEN: PAID -> SERVING (Đơn đã thanh toán không được mở lại để sửa món)
%%   - FORBIDDEN: PAID -> PENDING
%%   - FORBIDDEN: MERGED -> SERVING | PENDING | PAID (Đơn đã gộp đã chuyển hết items)
%%   - FORBIDDEN: VOIDED -> PENDING | SERVING | PAID | MERGED (Đơn đã huỷ là bất biến)
%%   - FORBIDDEN: SERVING -> PAID khi chỉ bấm nút "In tạm tính" / "Tạm tính tách đơn" (Invariant 4)
%%   - FORBIDDEN: SWAP đối với đơn order_type = 'TAKEAWAY' -> 409 Conflict
%%
%% [OrderItem Kitchen Status]:
%%   - FORBIDDEN: PRINTED -> NEW (Vi phạm Invariant 3 - Gây in lặp và nấu trùng món)
%%   - FORBIDDEN: CANCELLED -> NEW | PRINTED (Món đã huỷ không được khôi phục)
%%   - FORBIDDEN: Hard Delete bản ghi khi kitchen_status = 'PRINTED' (Phải chuyển sang CANCELLED)
%% ============================================================================
