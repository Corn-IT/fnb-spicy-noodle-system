%% QUY TẮC BẤT BIẾN ĐÃ KIỂM ĐỊNH TRONG ERD NÀY:
%% - Hard Invariant 2 (TAKEAWAY vs DINE_IN): orders.table_id NULLABLE cho TAKEAWAY,
%%   takeaway_number NULLABLE cho DINE_IN. Enforce bằng CHECK constraint chk_order_type_target.
%%   KHÔNG tồn tại bản ghi bàn "Mang về" trong bảng dining_tables.
%% - Hard Invariant 3 (Delta Split & Combo Explosion): Bảng vật lý COMBO_ITEMS phân rã
%%   sản phẩm station='COMBO' về đúng trạm vật lý (BEP_NAU, BEP_CHIEN, PHA_CHE, BEP_*).
%% - Hard Invariant 5 (Concurrency Control): Khoá dòng SELECT ... FOR UPDATE theo thứ tự
%%   orders (id ASC) -> dining_tables (id ASC).
%% - Hard Invariant 6 (Cashflow Settlement): Đầy đủ cash_amount, transfer_amount,
%%   subtotal_amount, discount_amount, payment_source, expected_cash_in_drawer,
%%   actual_counted_cash, discrepancy_amount, denominations_detail, note.
%% - Hard Invariant 7 (MDM Normalization): Composite UNIQUE (category, normalized_name).
%%   (Hàm PostgreSQL f_search_norm() dùng unaccent chỉ phục vụ tìm kiếm, không đổi normalized_name.)
%% - Hard Invariant 9 (UI Preferences): users.ui_preferences JSONB độc lập với Auth token.
%% - Hard Invariant 10 (Monetary Type): 100% cột tiền tệ sử dụng NUMERIC(12, 2).
%% ============================================================================

erDiagram
    MASTER_DATA ||--o{ EMPLOYEES : "position_id (ON DELETE RESTRICT)"
    MASTER_DATA ||--o{ EMPLOYEES : "specialty_id (ON DELETE RESTRICT)"
    MASTER_DATA ||--o{ INVENTORY_IMPORTS : "ingredient_mdm_id (ON DELETE RESTRICT)"
    MASTER_DATA ||--o{ INVENTORY_IMPORTS : "supplier_mdm_id (ON DELETE RESTRICT)"
    MASTER_DATA ||--o{ PRODUCTS : "category_id (ON DELETE SET NULL)"
    MASTER_DATA ||--o{ DISCOUNT_TARGETS : "category_id (ON DELETE CASCADE)"
    EMPLOYEES ||--o| USERS : "employee_id (Strict 1-1, ON DELETE RESTRICT)"
    USERS ||--o{ WORK_SCHEDULES : "created_by (ON DELETE RESTRICT)"
    USERS ||--o{ ORDERS : "cashier_id (ON DELETE SET NULL)"
    USERS ||--o{ INVENTORY_IMPORTS : "created_by (ON DELETE RESTRICT)"
    USERS ||--o{ CASH_DRAWER_SETTLEMENTS : "closed_by (ON DELETE RESTRICT)"
    USERS ||--o{ DISCOUNTS : "created_by (ON DELETE RESTRICT)"
    USERS ||--o{ PUSH_SUBSCRIPTIONS : "user_id (ON DELETE CASCADE)"
    USERS ||--o{ POS_DRAFTS : "created_by / updated_by (ON DELETE RESTRICT)"
    DINING_TABLES ||--o{ ORDERS : "table_id (Nullable for TAKEAWAY)"
    DINING_TABLES o|--o{ POS_DRAFTS : "table_id (Optional draft target; ON DELETE SET NULL)"
    ORDERS ||--o| DINING_TABLES : "active_order_id (Current open session)"
    ORDERS o|--o| POS_DRAFTS : "submitted_order_id (Idempotent draft result)"
    PAYMENT_ACCOUNTS ||--o{ ORDERS : "payment_account_id (ON DELETE RESTRICT)"
    DISCOUNTS ||--o{ ORDERS : "discount_id (ON DELETE RESTRICT)"
    DISCOUNTS ||--o{ DISCOUNT_TARGETS : "discount_id (ON DELETE CASCADE)"
    ORDERS ||--o{ ORDERS : "merged_into_order_id (Self-ref on MERGE)"
    ORDERS ||--|{ ORDER_ITEMS : "order_id (ON DELETE CASCADE)"
    PRODUCTS ||--o{ ORDER_ITEMS : "product_id (ON DELETE RESTRICT)"
    PRODUCTS ||--o{ COMBO_ITEMS : "parent_product_id (ON DELETE CASCADE)"
    PRODUCTS ||--o{ COMBO_ITEMS : "child_product_id (ON DELETE RESTRICT)"
    PRODUCTS ||--o{ MODIFIER_GROUPS : "product_id (ON DELETE CASCADE)"
    PRODUCTS ||--o{ DISCOUNT_TARGETS : "product_id (ON DELETE CASCADE)"
    MODIFIER_GROUPS ||--|{ MODIFIERS : "group_id (ON DELETE CASCADE)"

    MASTER_DATA {
        serial id PK "PRIMARY KEY"
        varchar category "NOT NULL (32): POSITION | SPECIALTY | INGREDIENT | UNIT | SUPPLIER | MENU_CATEGORY | KITCHEN_STATION | SYSTEM_CONFIG"
        varchar name "NOT NULL (255): Title Case (VD: Ba Chi Bo My)"
        varchar normalized_name UK "NOT NULL (255): Composite UNIQUE(category, normalized_name)"
        jsonb metadata "DEFAULT '{}': { default_unit, last_price, station, storeSettings, assets, ... }"
        boolean is_active "NOT NULL DEFAULT TRUE (Soft disable)"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    EMPLOYEES {
        serial id PK "PRIMARY KEY"
        varchar full_name "NOT NULL (255): Ho va ten day du"
        varchar short_name "NOT NULL (64): V.Anh hoac N.V.Anh (#12) khi trung"
        date dob "Ngay thang nam sinh"
        varchar phone "So dien thoai lien he (32)"
        text address "Dia chi noi o hien tai"
        varchar citizen_id UK "UNIQUE (32): So CCCD"
        varchar citizen_id_issued_place "Noi cap CCCD (255)"
        int position_id FK "NULLABLE FK -> master_data(id) [category=POSITION]"
        int specialty_id FK "NULLABLE FK -> master_data(id) [category=SPECIALTY]"
        date start_date "Ngay bat dau vao lam"
        varchar bank_name "Ten ngan hang nhan luong (255)"
        varchar bank_account_no "So tai khoan ngan hang (64)"
        varchar bank_account_name "Ten chu tai khoan ngan hang (255)"
        varchar avatar_url "URL anh dai dien (/api/v1/public/avatars/:id hoac URL)"
        jsonb attachment_urls "DEFAULT '[]': Danh sach file hop dong / CCCD"
        text note "Ghi chu nhan su"
        boolean is_deleted "NOT NULL DEFAULT FALSE (Soft delete / ngung hoat dong)"
        timestamptz deleted_at "NULLABLE: Thoi diem ngung hoat dong"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    USERS {
        serial id PK "PRIMARY KEY"
        int employee_id FK,UK "UNIQUE NOT NULL FK -> employees(id) (Strict 1-1)"
        varchar username UK "UNIQUE NOT NULL (64): Ten dang nhap"
        text password_hash "NOT NULL: Bcrypt hash (cost=10, min 6 chars)"
        boolean is_super_admin "NOT NULL DEFAULT FALSE (Bypass RBAC, UI readonly)"
        varchar role_label "NULLABLE (64): Nhan vai tro hien thi tuy chinh"
        jsonb permissions "NOT NULL DEFAULT '{}': 14-module CRUD + Sub-permissions matrix"
        jsonb ui_preferences "NOT NULL DEFAULT '{}': { theme, sidebarWidth, columnWidths, displayScale, navOrder, navGroupOrder, sidebarCollapsed, voiceAlertEnabled }"
        boolean is_active "NOT NULL DEFAULT TRUE (Account status)"
        varchar active_session_id "NULLABLE (64): Single-session ID hien tai"
        varchar active_session_ip "NULLABLE (64): IP phien dang nhap hien tai"
        varchar active_session_device "NULLABLE (128): Thiet bi phien hien tai"
        varchar active_session_agent "NULLABLE (512): User-Agent phien hien tai"
        timestamptz active_session_at "NULLABLE: Thoi diem bat dau phien hien tai"
        jsonb last_revoked_notice "NULLABLE: { reason, at } thong bao bi thu hoi phien"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    DINING_TABLES {
        serial id PK "PRIMARY KEY (Chi luu ban vat ly Ban 01..Ban N)"
        varchar name UK "UNIQUE NOT NULL (32): 'Ban 01' .. 'Ban 30'"
        varchar qr_token UK "UNIQUE NOT NULL (64): Short QR token / chuoi bao mat"
        varchar status "NOT NULL DEFAULT 'AVAILABLE' (16): AVAILABLE | PENDING | OCCUPIED"
        int active_order_id FK "NULLABLE FK -> orders(id) ON DELETE SET NULL"
    }

    PRODUCTS {
        serial id PK "PRIMARY KEY"
        varchar name "NOT NULL (255): Ten mon an / nuoc uong / combo"
        varchar subtitle "NULLABLE (255): Mo ta phu dong hien thi trong ngoac"
        int category_id FK "NULLABLE FK -> master_data(id) [category=MENU_CATEGORY]"
        numeric_12_2 price "NUMERIC(12,2) NOT NULL >= 0 (Invariant 10)"
        varchar station "NOT NULL (16): BEP_NAU | BEP_CHIEN | PHA_CHE | COMBO | BEP_*"
        boolean is_available "NOT NULL DEFAULT TRUE (Soft disable khi het mon)"
        varchar image_url "NULLABLE (2048): Anh mon an"
        int sort_order "NOT NULL DEFAULT 0: Thu tu hien thi tren Menu"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    COMBO_ITEMS {
        int parent_product_id PK,FK "FK -> products(id) [station='COMBO']"
        int child_product_id PK,FK "FK -> products(id) [physical station]"
        int quantity "NOT NULL DEFAULT 1 (> 0): So luong thanh phan trong Combo"
    }

    MODIFIER_GROUPS {
        serial id PK "PRIMARY KEY"
        int product_id FK "NOT NULL FK -> products(id) ON DELETE CASCADE"
        varchar name "NOT NULL (128): 'Cap do cay' | 'Size' | 'Do an mac dinh' | 'Do an chinh' | 'Them Topping'"
        boolean is_required "NOT NULL DEFAULT FALSE (True cho Cap do cay / Size)"
        int max_select "NOT NULL DEFAULT 1 (1 = Radio, >1 = Checkbox multi-select)"
        boolean is_auto_select "NOT NULL DEFAULT FALSE (Tu dong tich san tat ca khi mo mon)"
        boolean allow_substitution "NOT NULL DEFAULT FALSE (Logic doi mon chinh khi bo tich)"
    }

    MODIFIERS {
        serial id PK "PRIMARY KEY"
        int group_id FK "NOT NULL FK -> modifier_groups(id) ON DELETE CASCADE"
        varchar name "NOT NULL (128): 'Cap do 0'..'Cap do 7' | 'Size M/L' | 'Them Bo vien'"
        numeric_12_2 extra_price "NUMERIC(12,2) NOT NULL DEFAULT 0.00 (Invariant 10)"
        boolean is_default_checked "NOT NULL DEFAULT FALSE"
        boolean is_available "NOT NULL DEFAULT TRUE (Tam het topping/mon thanh phan)"
        varchar default_substitute_name "NULLABLE (128): Mon thay the mac dinh khi bo tich"
    }

    PAYMENT_ACCOUNTS {
        serial id PK "PRIMARY KEY"
        varchar label "NOT NULL (64): Ten goi nho (VD: TK Chinh VPBank)"
        varchar bank_code "NOT NULL (16): Ma ngan hang VietQR (VPB, VCB...)"
        varchar account_no "NOT NULL (32): So tai khoan ngan hang"
        varchar account_name "NOT NULL (128): Ten chu TK in hoa khong dau"
        int priority "NOT NULL DEFAULT 1: Thu tu uu tien xoay vong (1 = cao nhat)"
        boolean is_active "NOT NULL DEFAULT TRUE: Trang thai tham gia xoay vong"
        numeric_12_2 daily_limit "NULLABLE NUMERIC(12,2) > 0: Han muc ngay"
        numeric_12_2 monthly_limit "NULLABLE NUMERIC(12,2) > 0: Han muc thang"
        numeric_12_2 yearly_limit "NULLABLE NUMERIC(12,2) > 0: Han muc nam"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
        timestamptz updated_at "NOT NULL DEFAULT NOW()"
    }

    DISCOUNTS {
        serial id PK "PRIMARY KEY"
        varchar code UK "UNIQUE NOT NULL (32): Ma giam gia (VD: GIAM10, HAPPYHOUR)"
        varchar name "NOT NULL (128): Ten chuong trinh giam gia"
        varchar value_type "NOT NULL (16): PERCENT | FIXED"
        numeric_12_2 value "NUMERIC(12,2) NOT NULL > 0 (<=100 neu PERCENT)"
        numeric_12_2 max_discount_amount "NULLABLE NUMERIC(12,2) > 0 (Tran giam toi da cho PERCENT)"
        varchar scope "NOT NULL (16): ORDER | CATEGORY | PRODUCT"
        numeric_12_2 min_order_amount "NULLABLE NUMERIC(12,2) > 0: Gia tri don toi thieu"
        timestamptz starts_at "NULLABLE: Thoi diem bat dau hieu luc"
        timestamptz ends_at "NULLABLE: Thoi diem ket thuc hieu luc"
        jsonb active_weekdays "NOT NULL DEFAULT '[]': Mang ngay trong tuan ap dung"
        varchar time_window_start "NULLABLE (5): Khung gio bat dau HH:mm"
        varchar time_window_end "NULLABLE (5): Khung gio ket thuc HH:mm"
        int usage_limit "NULLABLE > 0: Gioi han so luot su dung"
        int used_count "NOT NULL DEFAULT 0: So luot da su dung"
        boolean is_active "NOT NULL DEFAULT TRUE"
        boolean is_archived "NOT NULL DEFAULT FALSE (Luu tru mem khi da dung)"
        int created_by FK "NOT NULL FK -> users(id) ON DELETE RESTRICT"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
        timestamptz updated_at "NOT NULL DEFAULT NOW()"
    }

    DISCOUNT_TARGETS {
        serial id PK "PRIMARY KEY"
        int discount_id FK "NOT NULL FK -> discounts(id) ON DELETE CASCADE"
        int category_id FK "NULLABLE FK -> master_data(id) ON DELETE CASCADE"
        int product_id FK "NULLABLE FK -> products(id) ON DELETE CASCADE"
    }

    ORDERS {
        serial id PK "PRIMARY KEY"
        varchar order_code UK "UNIQUE NOT NULL (32): Format 'HD-YYYYMMDD-NNNN'"
        varchar order_type "NOT NULL (16): 'DINE_IN' | 'TAKEAWAY' (Invariant 2)"
        varchar order_source "NOT NULL (16): 'QR_CODE' | 'POS_COUNTER'"
        int table_id FK "NULLABLE FK -> dining_tables(id) (MUST BE NULL IF TAKEAWAY)"
        int takeaway_number "NULLABLE INT (MUST NOT BE NULL IF TAKEAWAY, reset daily)"
        varchar status "NOT NULL (16): PENDING | SERVING | PAID | MERGED | VOIDED"
        varchar payment_method "NULLABLE (16): CASH | TRANSFER | SPLIT"
        int payment_account_id FK "NULLABLE FK -> payment_accounts(id) ON DELETE RESTRICT"
        numeric_12_2 cash_amount "NUMERIC(12,2) NOT NULL DEFAULT 0.00 (Tien mat thuc thu)"
        numeric_12_2 transfer_amount "NUMERIC(12,2) NOT NULL DEFAULT 0.00 (Tien CK VietQR)"
        numeric_12_2 subtotal_amount "NUMERIC(12,2) NOT NULL DEFAULT 0.00 (Tam tinh truoc giam)"
        numeric_12_2 discount_amount "NUMERIC(12,2) NOT NULL DEFAULT 0.00 (So tien giam gia)"
        int discount_id FK "NULLABLE FK -> discounts(id) ON DELETE RESTRICT"
        jsonb discount_snapshot "NULLABLE: Snapshot ma giam gia / giam tay tai thoi diem ap"
        numeric_12_2 total_amount "NUMERIC(12,2) NOT NULL DEFAULT 0.00 (= subtotal - discount)"
        int merged_into_order_id FK "NULLABLE FK -> orders(id) (Khi status='MERGED')"
        jsonb table_transfer_logs "NOT NULL DEFAULT '[]': [{ action, fromTable, toTable, timestamp, reason }]"
        int cashier_id FK "NULLABLE FK -> users(id): Thu ngan xu ly"
        text note "NULLABLE: Ghi chu chung cua don hang"
        text void_reason "NULLABLE: Ly do huy don (Bat buoc khi status='VOIDED')"
        jsonb pending_payment_edit "NULLABLE: Yeu cau sua PTTT cho quan ly duyet (invoices:approve)"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
        timestamptz paid_at "NULLABLE: Thoi diem chot thanh toan (status='PAID')"
    }

    POS_DRAFTS {
        varchar id PK "PRIMARY KEY (CUID, NOT NULL)"
        varchar order_type "NULLABLE: DINE_IN | TAKEAWAY; NULL khi chua chon dich vu"
        int table_id FK "NULLABLE FK -> dining_tables(id) ON DELETE SET NULL"
        jsonb items "NOT NULL DEFAULT '[]': productId, quantity, modifiers, itemNote, isTakeaway; KHONG luu gia"
        text note "NULLABLE: Ghi chu se duoc copy vao order khi submit"
        int revision "NOT NULL DEFAULT 1: optimistic concurrency token"
        int created_by FK "NOT NULL FK -> users(id)"
        int updated_by FK "NOT NULL FK -> users(id)"
        int submitted_order_id FK "NULLABLE UNIQUE FK -> orders(id) ON DELETE RESTRICT"
        varchar submit_idempotency_key "NULLABLE (128): key cho submit replay"
        timestamptz submitted_at "NULLABLE: null khi draft con dang cho"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
        timestamptz updated_at "NOT NULL DEFAULT NOW()"
    }

    TAKEAWAY_SEQUENCES {
        char_8 business_date PK "PRIMARY KEY: YYYYMMDD theo ngay kinh doanh +07:00"
        int last_number "NOT NULL DEFAULT 0: so TAKEAWAY cuoi cung da cap"
        timestamptz updated_at "NOT NULL DEFAULT NOW()"
    }

    ORDER_ITEMS {
        serial id PK "PRIMARY KEY"
        int order_id FK "NOT NULL FK -> orders(id) ON DELETE CASCADE"
        int product_id FK "NOT NULL FK -> products(id) ON DELETE RESTRICT"
        int quantity "NOT NULL CHECK (quantity > 0)"
        numeric_12_2 unit_price "NUMERIC(12,2) NOT NULL (Don gia goc + extra_price topping)"
        jsonb modifiers_snapshot "NOT NULL DEFAULT '[]': [{ groupId, modifierId, name, extraPrice, ... }]"
        text item_note "NULLABLE: Ghi chu mon (VD: It hanh, ot de rieng)"
        int batch_no "NOT NULL DEFAULT 1: Luot goi 1, 2, 3..."
        varchar item_source "NOT NULL DEFAULT 'POS_COUNTER' (16): POS_COUNTER | QR_CODE"
        varchar kitchen_status "NOT NULL DEFAULT 'NEW' (16): NEW | PRINTED | CANCELLED"
        boolean is_takeaway "NOT NULL DEFAULT FALSE: Mon goi mang ve trong don tai ban"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    INVENTORY_IMPORTS {
        serial id PK "PRIMARY KEY"
        int ingredient_mdm_id FK "NOT NULL FK -> master_data(id) [category=INGREDIENT]"
        int supplier_mdm_id FK "NULLABLE FK -> master_data(id) [category=SUPPLIER]"
        varchar supplier_name_snapshot "NULLABLE (255): Ten nha cung cap tai thoi diem nhap"
        varchar item_name_snapshot "NOT NULL (255): Ten nguyen lieu tai thoi diem nhap"
        varchar unit_name "NOT NULL (64): Don vi tinh (Kg, Thung, Goi, Ket, Bao)"
        numeric_12_2 unit_price "NUMERIC(12,2) NOT NULL >= 0 (Don gia nhap)"
        numeric_10_2 quantity "NUMERIC(10,2) NOT NULL > 0 (So luong nhap)"
        numeric_12_2 total_cost "NUMERIC(12,2) NOT NULL >= 0 (= ROUND(unit_price * quantity, 2))"
        varchar payment_source "NOT NULL DEFAULT 'CASH_DRAWER' (16): CASH_DRAWER | EXTERNAL"
        date import_date "NOT NULL DEFAULT CURRENT_DATE: Ngay nhap hang"
        text note "NULLABLE: Ghi chu phieu nhap"
        int created_by FK "NOT NULL FK -> users(id): Nhan vien lap phieu"
        boolean is_deleted "NOT NULL DEFAULT FALSE (Soft delete)"
        timestamptz deleted_at "NULLABLE: Thoi diem huy phieu nhap"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    CASH_DRAWER_SETTLEMENTS {
        serial id PK "PRIMARY KEY"
        date settlement_date "NOT NULL: Ngay ket ca"
        varchar shift_name "NOT NULL (64): Ten ca (CA_NGAY, Ca Sang, Ca Toi...)"
        numeric_12_2 opening_budget "NUMERIC(12,2) NOT NULL: Ngan sach tien le dau ca"
        numeric_12_2 total_cash_sales "NUMERIC(12,2) NOT NULL: Tong thu TIEN MAT (CASH + cash_amount of SPLIT)"
        numeric_12_2 total_transfer_sales "NUMERIC(12,2) NOT NULL: Tong thu CHUYEN KHOAN QR (Doi soat NH)"
        numeric_12_2 total_cash_imports "NUMERIC(12,2) NOT NULL: Tong chi TIEN KET nhap hang (CASH_DRAWER)"
        numeric_12_2 expected_cash_in_drawer "NUMERIC(12,2) NOT NULL: opening_budget + total_cash_sales - total_cash_imports"
        numeric_12_2 actual_counted_cash "NUMERIC(12,2) NOT NULL: Tien mat thuc dem tu bang menh gia"
        numeric_12_2 discrepancy_amount "NUMERIC(12,2) NOT NULL: actual_counted_cash - expected_cash_in_drawer"
        varchar status "NOT NULL (16): MATCHED (=0) | SURPLUS (>0) | SHORTAGE (<0)"
        jsonb denominations_detail "NOT NULL DEFAULT '{}': { '500000': n, ..., '1000': n }"
        text note "NULLABLE: Ghi chu giai trinh chenh lech (Bat buoc khi discrepancy != 0)"
        int closed_by FK "NOT NULL FK -> users(id): Thu ngan dong ca"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    WORK_SCHEDULES {
        serial id PK "PRIMARY KEY"
        date week_start_date "NOT NULL: Ngay Thu Hai dau tuan (YYYY-MM-DD)"
        int day_of_week "NOT NULL CHECK (day_of_week BETWEEN 0 AND 6): 0=Mon .. 6=Sun"
        varchar time_slot "NOT NULL (128): Ten khung gio / ca"
        jsonb employee_ids "NOT NULL DEFAULT '[]': Danh sach nhan vien & attendances (FULL_SHIFT | CUSTOM_HOURS)"
        int created_by FK "NOT NULL FK -> users(id): Quan ly xep lich"
        timestamptz updated_at "NOT NULL DEFAULT NOW()"
    }

    AUDIT_LOGS {
        serial id PK "PRIMARY KEY"
        varchar module "NOT NULL (32): POS | DISCOUNTS | MENU | INVOICES | INVENTORY | CASHFLOW | PAYMENT_QR | EMPLOYEES | SCHEDULES | PAYROLL | MDM | RBAC | SETTINGS"
        varchar action "NOT NULL (32): Ten hanh dong nghiep vu"
        int actor_id "NULLABLE: ID user thuc hien (null neu he thong tu dong)"
        varchar actor_full_name "NOT NULL (128)"
        varchar actor_username "NOT NULL (64)"
        text summary "NOT NULL: Mo ta ngan gon thao tac"
        varchar ip_address "NULLABLE (64): IP client (Chi Super Admin xem duoc)"
        varchar device_label "NULLABLE (128): Thiet bi / trinh duyet"
        jsonb metadata "NOT NULL DEFAULT '{}': Chi tiet diff / payload"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
    }

    PUSH_SUBSCRIPTIONS {
        serial id PK "PRIMARY KEY"
        int user_id FK "NOT NULL FK -> users(id) ON DELETE CASCADE"
        varchar session_id "NULLABLE (64): Gan voi phien dang nhap single-session"
        varchar endpoint UK "UNIQUE NOT NULL (2048): HTTPS Web Push endpoint"
        varchar p256dh "NOT NULL (512): Khoa cong khai ECDH"
        varchar auth "NOT NULL (256): Khoa auth Web Push"
        varchar user_agent "NULLABLE (512)"
        varchar device_label "NULLABLE (128)"
        timestamptz created_at "NOT NULL DEFAULT NOW()"
        timestamptz updated_at "NOT NULL DEFAULT NOW()"
        timestamptz last_notified_at "NULLABLE: Lan day thong bao gan nhat"
    }

%% ============================================================================
%% PHỤ LỤC RÀNG BUỘC VẬT LÝ, HÀM & INDEX TRONG PRISMA MIGRATIONS (SQL DDL)
%% ============================================================================
%% 1. Ràng buộc CHECK cho DINE_IN vs TAKEAWAY (Hard Invariant 2):
%%    chk_order_type_target:
%%      (order_type = 'DINE_IN' AND table_id IS NOT NULL AND takeaway_number IS NULL) OR
%%      (order_type = 'TAKEAWAY' AND table_id IS NULL AND takeaway_number IS NOT NULL)
%%
%% 2. Ràng buộc CHECK cho Thanh toán CASH / TRANSFER / SPLIT (Hard Invariant 6 & EC-FIN-02):
%%    chk_order_payment_amounts:
%%      status <> 'PAID' OR (
%%        (payment_method = 'CASH' AND cash_amount = total_amount AND transfer_amount = 0) OR
%%        (payment_method = 'TRANSFER' AND transfer_amount = total_amount AND cash_amount = 0) OR
%%        (payment_method = 'SPLIT' AND cash_amount > 0 AND transfer_amount > 0 AND (cash_amount + transfer_amount) = total_amount)
%%      )
%%
%% 3. Ràng buộc CHECK cho Giảm giá & Đối tượng áp dụng (Story 18):
%%    chk_order_discount_amounts: discount_amount >= 0 AND discount_amount <= subtotal_amount AND total_amount = (subtotal_amount - discount_amount)
%%    chk_discount_value: value > 0 AND (value_type <> 'PERCENT' OR value <= 100) AND ...
%%    chk_discount_usage: used_count >= 0 AND (usage_limit IS NULL OR (usage_limit > 0 AND used_count <= usage_limit))
%%    chk_discount_target_one: (category_id IS NOT NULL AND product_id IS NULL) OR (category_id IS NULL AND product_id IS NOT NULL)
%%
%% 4. Ràng buộc CHECK cho Payment Accounts, Combo, Order Items & Cashflow:
%%    chk_payment_accounts_limits_positive: daily_limit/monthly_limit/yearly_limit IS NULL OR > 0
%%    chk_combo_no_self_ref: parent_product_id <> child_product_id
%%    chk_order_item_source: item_source IN ('POS_COUNTER', 'QR_CODE')
%%    chk_void_reason_required, chk_settlement_status_amounts, chk_settlement_note_required
%%
%% 5. Unique & Partial Unique Indexes:
