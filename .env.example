# API server (FNB_ variables are preferred; standard names support Prisma CLI)
FNB_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fnb_pos?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/fnb_pos?schema=public
FNB_JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long-for-fnb-pos-2026
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long-for-fnb-pos-2026
FNB_JWT_EXPIRES_IN=15m
JWT_EXPIRES_IN=15m
FNB_JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=7d
FNB_PORT=3000
PORT=3000
FNB_CORS_ORIGIN=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Cloudflare R2 (optional in development)
FNB_R2_ACCOUNT_ID=
FNB_R2_ACCESS_KEY_ID=
FNB_R2_SECRET_ACCESS_KEY=
FNB_R2_BUCKET_NAME=fnb-pos-assets
FNB_R2_BACKUP_BUCKET=fnb-pos-backups

# VietQR (optional; configure all three values to enable dynamic VietQR on provisional bills)
FNB_VIETQR_BANK_ID=970422
FNB_VIETQR_ACCOUNT_NO=0123456789
FNB_VIETQR_ACCOUNT_NAME=MI CAY SON BAO

# Web app
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_SOCKET_URL=http://localhost:3000/pos

NODE_ENV=development
