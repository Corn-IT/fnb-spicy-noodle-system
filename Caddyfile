{$DOMAIN:localhost} {
    encode gzip zstd

    # Nếu bạn dùng Cloudflare Origin Certificate để bật SSL Full (Strict) vĩnh viễn 15 năm,
    # hãy mount thư mục ./certs vào /etc/caddy/certs trong docker-compose.yml và bỏ dấu # ở dòng dưới:
    # tls /etc/caddy/certs/origin.crt /etc/caddy/certs/origin.key

    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()"
        X-Robots-Tag "noindex, nofollow, noarchive"
    }

    handle /api/* {
        reverse_proxy api-server:3000
    }

    handle /socket.io/* {
        reverse_proxy api-server:3000
    }

    # Static assets (JS/CSS hash & Vietnamese MP3 voice clips): cache dài hạn
    @immutable_static {
        path /assets/* /audio/*
    }
    handle @immutable_static {
        root * /srv/web-app
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    # React SPA fallback (index.html luôn kiểm tra bản mới)
    handle {
        root * /srv/web-app
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
